{
  "name": "shared-timer",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typecheck": "tsc --noEmit && tsc --noEmit -p test/worker",
    "local": "node server.js",
    "show": "sh scripts/show.sh",
    "lint": "biome lint --error-on-warnings",
    "lint:fix": "biome lint --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "hono": "^4.7.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20261004.1",
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.147.0"
  }
}
